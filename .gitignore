# ═══════════════════════════════════════════════════════════════
#  NotifyFlow .gitignore
#  Java / Maven / Spring Boot / Docker / IDE
# ═══════════════════════════════════════════════════════════════

# ── Environment & Secrets ──────────────────────────────────────
# NEVER commit real credentials
.env
*.env
!.env.example

# ── Maven Build Output ─────────────────────────────────────────
notify-backend/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper (commit the wrapper, not the binary)
.mvn/wrapper/maven-wrapper.properties
# Uncomment if you want to commit the wrapper properties:
# !.mvn/wrapper/maven-wrapper.properties

# ── Java ───────────────────────────────────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ── Spring Boot ────────────────────────────────────────────────
# Spring Boot DevTools restart trigger file
.spring-boot-devtools.properties
HELP.md

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
*.log.*
log/

# ── Docker ─────────────────────────────────────────────────────
# Docker override files (local customisations)
docker-compose.override.yml
docker-compose.local.yml

# ── IntelliJ IDEA ─────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
# Uncomment to ignore editor config (team preference):
# .editorconfig

# ── Eclipse ────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# ── VS Code ────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ── NetBeans ───────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ── OS Generated ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Test & Coverage ────────────────────────────────────────────
# JaCoCo coverage data (report is regenerated by mvn verify)
*.exec

# ── Terraform / Infra (future) ─────────────────────────────────
*.tfstate
*.tfstate.backup
.terraform/

# ── Miscellaneous ──────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
*~
.cache/