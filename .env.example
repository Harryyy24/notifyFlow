# ─────────────────────────────────────────────────────────────
#  NotifyFlow — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_DATABASE=notifyflow_db
MYSQL_USER=notifyflow_user
MYSQL_PASSWORD=notifyflow_pass_change_me

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=redis_pass_change_me

# ── JWT ────────────────────────────────────────────────────
# Must be a Base64-encoded string of at least 64 bytes for HS512
# Generate with: openssl rand -base64 64
JWT_SECRET=your_very_long_base64_encoded_secret_here_change_me
JWT_EXPIRATION_MS=86400000   # 24 hours in milliseconds